---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import AppointmentButton from '../../components/AppointmentButton.astro';
import { EVIDENCE, formatDate, publishedPosts } from '../../lib/posts';
import { blogPosting, breadcrumb } from '../../lib/schema';

export const getStaticPaths = async () =>
  // Los borradores no generan ruta: no se publican ni quedan accesibles por URL.
  publishedPosts(await getCollection('posts')).map((post) => ({ params: { slug: post.id }, props: { post } }));

type Props = { post: CollectionEntry<'posts'> };
const { post } = Astro.props as Props;
const { Content } = await render(post);
const url = `/blog/${post.id}/`;
const evidence = post.data.evidence ? EVIDENCE[post.data.evidence] : null;
const cover = post.data.cover;

const schema = [
  blogPosting({
    title: post.data.title,
    description: post.data.description,
    url,
    date: post.data.date,
    image: cover?.src,
  }),
  breadcrumb([
    { name: 'Inicio', url: '/' },
    { name: 'Centro de Conocimiento', url: '/blog/' },
    { name: post.data.title, url },
  ]),
];
---
<Base title={`${post.data.title} - Clínica Angular`} description={post.data.description} ogImage={cover} schema={schema}>
  <article class="container-site section-y">
    <nav aria-label="Migas de pan" class="mb-6 text-[15px] text-muted">
      <a href="/" class="text-primary underline-offset-2 hover:underline">Inicio</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <a href="/blog/" class="text-primary underline-offset-2 hover:underline">Centro de Conocimiento</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span aria-current="page">{post.data.title}</span>
    </nav>

    <header class="prose-measure">
      {evidence && (
        <span class:list={['inline-block rounded-full px-3 py-1 text-[13px] font-semibold', evidence.class]}>{evidence.label}</span>
      )}
      <h1 class="title-section mt-4">{post.data.title}</h1>
      <time datetime={post.data.date.toISOString().slice(0, 10)} class="mt-3 block text-[16px] text-muted">
        {formatDate(post.data.date)}
      </time>
      <p class="mt-4 text-[19px] text-muted">{post.data.description}</p>
    </header>

    {cover && (
      <Image src={cover} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 900px, 100vw" class="mt-10 w-full rounded-card object-cover shadow-soft" />
    )}

    <div class="post-body prose-measure mt-10 text-[18px]"><Content /></div>

    <div class="mt-12 flex flex-wrap items-center gap-4 border-t border-border pt-8">
      <Button href="/blog/" variant="primary" shape="rounded" caps={false}>Volver al Centro de Conocimiento</Button>
      <AppointmentButton />
    </div>
  </article>
</Base>

<style is:global>
  /* El HTML lo genera Markdown, así que no lleva el atributo de los estilos con alcance de
     Astro: se estila de forma global bajo `.post-body`. No se usa @tailwindcss/typography. */
  .post-body > * + * { margin-top: 1.25em; }
  .post-body h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-top: 2.5rem; }
  .post-body h3 { font-size: clamp(1.25rem, 2.2vw, 1.5rem); margin-top: 2rem; }
  .post-body a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 2px; }
  .post-body ul, .post-body ol { padding-left: 1.5rem; }
  .post-body ul { list-style: disc; }
  .post-body ol { list-style: decimal; }
  .post-body li + li { margin-top: 0.5rem; }
  .post-body strong { font-weight: 600; }
  .post-body blockquote {
    border-left: 4px solid var(--color-accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    color: var(--color-muted);
    font-style: italic;
  }
  .post-body img { border-radius: var(--radius-card); }
  .post-body hr { border-color: var(--color-border); }
  .post-body code {
    background: var(--color-bg-alt);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    font-size: 0.9em;
  }
  .post-body table { width: 100%; border-collapse: collapse; }
  .post-body th, .post-body td { border: 1px solid var(--color-border); padding: 0.6rem 0.8rem; text-align: left; }
  .post-body th { background: var(--color-bg-alt); }
</style>
