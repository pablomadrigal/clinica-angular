---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import ChatButton from '../../components/ChatButton.astro';
import ContactSection from '../../components/ContactSection.astro';
import { site } from '../../data/site';
import { EVIDENCE, formatDate, publishedPosts } from '../../lib/posts';
import { breadcrumb, medicalWebPage } from '../../lib/schema';

// La colección arranca vacía a propósito: el contenido clínico lo aporta la clínica.
// Hasta entonces la página muestra un estado vacío explícito, nunca artículos de relleno.
const posts = publishedPosts(await getCollection('posts'));

const title = 'Centro de Conocimiento';
const description =
  'Artículos de Clínica Angular sobre podología, cuidado de heridas, fisioterapia y salud del pie, escritos por nuestro equipo clínico.';
const schema = [
  medicalWebPage({ name: title, description, url: '/blog/' }),
  breadcrumb([
    { name: 'Inicio', url: '/' },
    { name: title, url: '/blog/' },
  ]),
];
---
<Base title={`${title} - Clínica Angular`} description={description} schema={schema}>
  <section class="bg-bg-alt">
    <div class="container-site section-y">
      <nav aria-label="Migas de pan" class="mb-6 text-[15px] text-muted">
        <a href="/" class="text-primary underline-offset-2 hover:underline">Inicio</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span aria-current="page">{title}</span>
      </nav>
      <h1 class="title-hero">{title}</h1>
      <p class="prose-measure mt-5 text-[19px] text-muted">{description}</p>
    </div>
  </section>

  <section class="container-site section-y">
    {posts.length === 0 ? (
      <div class="mx-auto max-w-[760px] rounded-panel border border-border bg-white p-8 text-center shadow-soft md:p-12">
        <h2 class="title-card">Todavía no hay artículos publicados</h2>
        <p class="prose-measure mx-auto mt-4 text-[17px] text-muted">
          Estamos preparando los primeros contenidos del Centro de Conocimiento. Mientras tanto, si
          tiene una duda sobre su caso, escríbanos y la resolvemos con usted.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <ChatButton />
          <Button href="/contactenos/" variant="primary">Contáctenos</Button>
        </div>
      </div>
    ) : (
      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li class="flex h-full flex-col overflow-hidden rounded-card border border-border bg-white shadow-soft transition-shadow hover:shadow-lift">
            {post.data.cover && (
              <Image src={post.data.cover} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="h-48 w-full object-cover" />
            )}
            <div class="flex flex-1 flex-col p-6">
              {post.data.evidence && (
                <span class:list={['mb-3 self-start rounded-full px-3 py-1 text-[13px] font-semibold', EVIDENCE[post.data.evidence].class]}>
                  {EVIDENCE[post.data.evidence].label}
                </span>
              )}
              <h2 class="title-card">
                <a href={`/blog/${post.id}/`} class="underline-offset-4 hover:underline">{post.data.title}</a>
              </h2>
              <time datetime={post.data.date.toISOString().slice(0, 10)} class="mt-2 text-[15px] text-muted">
                {formatDate(post.data.date)}
              </time>
              <p class="mt-3 text-[16px] text-muted">{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <ContactSection address={site.addresses.home} />
</Base>
