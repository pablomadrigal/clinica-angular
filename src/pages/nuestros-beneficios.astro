---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import BackHome from '../components/BackHome.astro';
import ContactForm from '../components/ContactForm.astro';
import heroBg from '../assets/Foto5-Angular-Podologia-Costa-Rica-1-2.jpg';
import medismart from '../assets/Logo-Boton2-MediSmart-Angular-Clinica-del-pie-Costa-Rica-1.png';
import i1 from '../assets/Group-245464941.png';
import i2 from '../assets/Group-245464930.png';
import i3 from '../assets/Group-245464931.png';
import i4 from '../assets/Group-245464932.png';
import i5 from '../assets/Group-245464933.png';
import kLaser from '../assets/antisel-physio-k-laser-cube-4-f.jpg';
import pion from '../assets/Captura-de-pantalla-2026-03-16-121826.png';
// Los cinco `Group-2454649xx.png` son tarjetas completas (foto + título + viñetas) ya
// maquetadas en el propio PNG (confirmado al inspeccionarlas); el orden replica el de
// la captura nuestros-beneficios-desktop.png: fila de 3 + fila de 2 centrada.
// El texto de cada tarjeta va horneado en la imagen, así que el `alt` transcribe
// literalmente el título y las viñetas visibles (leídos abriendo cada PNG).
const icons = [
  {
    src: i1,
    alt: 'Somos una opción accesible para la clase media: Posibilidad de abarcar mayor porción de mercado. Percibido como un médico dedicado a la comunidad. Facilidad económica, por ende, posibilidad de mayor adherencia consultas y tratamientos.',
  },
  {
    src: i2,
    alt: 'Últimas tendencias podológicas y de heridas: El paciente recibe tratamientos de punta. Posee reconocimiento nacional e internacional por la comunidad clínica. Le permite ser vocero y transmitir sus conocimientos en podología y heridas.',
  },
  {
    src: i3,
    alt: 'Diagnóstico clínicointegral: Creamos vínculo. Creamos flujo de pacientes a red de contactos de especialistas. Atención integral para resolución pronta y correcta. Identificamos padecimientos y comorbilidades no necesariamente podológicas o de heridas.',
  },
  {
    src: i4,
    alt: 'Posgrado en heridas: Posibilidad de abarcar mayor porción de mercado. Percibido como un médico dedicado a la comunidad. Facilidad económica, por ende, posibilidad de mayor adherencia consultas y tratamientos.',
  },
  {
    src: i5,
    alt: 'Uso de canales digitales: Mayor alcance publicitario y captación de pacientes/prospectos. Información de la clínica se encuentra con facilidad. Retroalimentación de clientes previos.',
  },
];
---
<Base title="Nuestros Beneficios - Clínica Angular">
  <section class="container-site section-y text-center" data-animate>
    <h1 class="title-hero font-semibold">Nuestros Beneficios</h1>
  </section>

  {/* La franja de MediSmart era dorada a pantalla completa con la foto encima; ahora es
      franja de marca: la foto se atenúa con un velo púrpura para que el texto encima se lea. */}
  <section class="relative isolate section-y overflow-hidden bg-primary">
    <Image src={heroBg} alt="" width={1440} class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-primary/70" aria-hidden="true"></div>
    <div class="container-site relative grid items-center gap-10 lg:grid-cols-[1fr_380px]">
      <div class="text-center" data-animate>
        <p class="title-section font-display font-semibold leading-none text-white">PAGUE UN</p>
        <p class="font-display text-[48px] font-bold leading-none text-accent-light sm:text-[65px] md:text-[90px]">50% MENOS</p>
        <p class="title-card font-display font-semibold text-white">EN SU CONSULTA MÉDICA</p>
        <Image src={medismart} alt="MediSmart" width={220} class="mx-auto mt-6 w-[220px]" />
      </div>
      <div class="rounded-panel bg-white p-8 shadow-lift">
        <h2 class="mb-5 title-card font-semibold">¡Contáctenos!</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="section-y bg-primary text-center">
    <div class="container-site" data-animate>
      <h2 class="title-section font-semibold text-white">¿Por qué elegir Nuestros Servicios?</h2>
      {/* Sobre púrpura el dorado va en su versión clara: `accent-text` no pasa AA acá. */}
      <p class="mt-3 text-[17px] font-medium text-accent-light md:text-[19px]">Somos una opción accesible para la clase media</p>
      <div class="mt-10 flex flex-wrap justify-center gap-8">
        {icons.map((ic) => <Image src={ic.src} alt={ic.alt} width={340} class="w-[280px] drop-shadow-lg sm:w-[320px]" />)}
      </div>
    </div>
  </section>

  <section class="section-y bg-bg-alt">
    <div class="container-site">
      <h2 class="title-section text-center font-semibold">Contamos con Tecnología Actualizada</h2>
      <div class="mt-10 grid items-center gap-10 md:grid-cols-2">
        <div class="text-center md:text-left" data-animate>
          <h3 class="title-card font-semibold text-primary">Cube 4 K-Laser</h3>
          <p class="prose-measure mt-3 text-[17px] leading-relaxed text-text">Sinónimo de terapia dinámica. El software intuitivo k-laser consta de varias etapas dinámicas que caracterizan el tratamiento seleccionado.</p>
          <Button href="/k-laser/" variant="primary" shape="rounded" caps={false} class="mt-5">Más Información</Button>
        </div>
        <div data-reveal-media>
          <Image src={kLaser} alt="K-Laser Cube 4" width={640} class="w-full rounded-card shadow-soft" />
        </div>
        {/* En una sola columna el grid apilaría la foto del Pion antes de su propio texto
            (queda pegada a la tarjeta del K-Laser); en móvil se invierte el par. */}
        <div class="order-2 md:order-none" data-reveal-media>
          <Image src={pion} alt="Láser Pion" width={640} class="w-full rounded-card shadow-soft" />
        </div>
        <div class="order-1 text-center md:order-none md:text-left" data-animate>
          <h3 class="title-card font-semibold text-primary">Láser Pion</h3>
          <p class="prose-measure mt-3 text-[17px] leading-relaxed text-text">Usada para tratar onicomicosis, verrugas plantares, helomas y aliviar dolores como la fascitis plantar.</p>
          <Button href="/laser-pion/" variant="primary" shape="rounded" caps={false} class="mt-5">Más Información</Button>
        </div>
      </div>
    </div>
  </section>

  <BackHome />
</Base>
