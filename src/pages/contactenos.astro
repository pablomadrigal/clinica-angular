---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AppointmentWizard from '../components/booking/AppointmentWizard.astro';
import BackHome from '../components/BackHome.astro';
import Contact from '../components/icons/Contact.astro';
import Social from '../components/icons/Social.astro';
import { CHAT_URL } from '../lib/whatsapp';
import insta from '../assets/Insta-GC-2-1.jpg';
import horario from '../assets/Group-245464942.png';
import direccion from '../assets/Group-245464943.png';
import { site } from '../data/site';
import { breadcrumb, medicalWebPage } from '../lib/schema';

const socials = [
  { name: 'facebook' as const, href: site.social.facebook, label: 'facebook.com/AngularClinica' },
  { name: 'instagram' as const, href: site.social.instagram, label: 'instagram.com/clinica_angular' },
  { name: 'tiktok' as const, href: site.social.tiktok, label: '@ClinicaDelPieAngular' },
];
const pills = [
  { name: 'phone' as const, href: site.phoneHref, label: site.phoneIntl, target: undefined },
  { name: 'mail' as const, href: `mailto:${site.email}`, label: site.email, target: undefined },
  { name: 'whatsapp' as const, href: CHAT_URL, label: site.whatsappIntl, target: '_blank' },
];

const descripcion =
  'Agendá tu cita en Clínica Angular: elegí servicio, profesional, sede y horario, y el equipo te confirma la disponibilidad por WhatsApp.';
const schema = [
  medicalWebPage({ name: 'Contáctenos', description: descripcion, url: '/contactenos/' }),
  breadcrumb([
    { name: 'Inicio', url: '/' },
    { name: 'Contáctenos', url: '/contactenos/' },
  ]),
];
---
<Base title="Contáctenos - Clínica Angular" description={descripcion} schema={schema}>
  <section class="bg-bg-alt">
    <div class="container-site section-y">
      <nav aria-label="Ruta de navegación" class="mb-6 text-[16px] text-muted">
        <a href="/" class="text-primary underline-offset-2 hover:underline">Inicio</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span aria-current="page">Contáctenos</span>
      </nav>
      <h1 class="title-hero">Contáctenos</h1>
      <p class="prose-measure mt-5 text-[19px] text-muted">{descripcion}</p>
    </div>
  </section>
  <section class="container-site section-y">
    <div class="grid items-start gap-10 lg:grid-cols-[1.5fr_1fr]">
      <AppointmentWizard />
      <div class="rounded-panel border border-border bg-white p-6 shadow-soft">
        <iframe src={site.mapEmbedUrl} title="Ubicación de Clínica Angular" class="h-[290px] w-full rounded-field border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <p class="mt-5 flex items-start gap-3 text-[17px] font-medium text-text">
          <Contact name="pin" class="mt-1 h-5 w-5 shrink-0 text-accent-text" />
          {site.addresses.contacto}
        </p>
        <p class="mt-3 flex items-center gap-3 text-[17px] font-medium text-text">
          <Contact name="phone" class="h-5 w-5 shrink-0 text-accent-text" />
          <a href={site.phoneHref} class="text-primary underline-offset-2 hover:underline">{site.phoneIntl}</a>
        </p>
      </div>
    </div>
  </section>
  <section class="container-site section-y">
    <div class="grid items-center gap-10 lg:grid-cols-3">
      <div class="mx-auto w-full max-w-[280px]" data-reveal-media>
        <Image src={insta} alt="Clínica Angular en Instagram" width={360} class="w-full rounded-card shadow-lift" />
      </div>
      <div class="space-y-8 text-center">
        <div>
          <Image src={horario} alt="Horario" width={220} class="mx-auto h-auto w-[220px]" />
          {site.hoursLong.map((h) => <p class="mt-3 text-[17px] text-text">{h}</p>)}
        </div>
        <div>
          <Image src={direccion} alt="Dirección" width={220} class="mx-auto h-auto w-[220px]" />
          <p class="mt-3 text-[17px] text-text">{site.addresses.contactoLargo}</p>
        </div>
      </div>
      <div class="flex flex-col items-center gap-4">
        {pills.map((p) => (
          <a href={p.href} target={p.target} rel={p.target === '_blank' ? 'noopener' : undefined} class="flex min-h-[56px] w-full max-w-[260px] items-center justify-center gap-3 rounded-full bg-primary px-6 py-3 text-[17px] font-medium text-white transition-colors hover:bg-primary-dark">
            <Contact name={p.name} class="h-5 w-5 shrink-0" />
            {p.label}
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="container-site section-y text-center">
    <h2 class="title-section font-semibold">¡Síganos también en Redes Sociales!</h2>
    <ul class="mt-8 grid gap-8 sm:grid-cols-3">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" class="group flex flex-col items-center gap-3">
            <span class="grid h-14 w-14 place-items-center rounded-field bg-primary text-white transition-colors group-hover:bg-primary-dark"><Social name={s.name} class="h-6 w-6" /></span>
            <span class="text-[17px] font-semibold text-accent-text">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <BackHome />
</Base>
