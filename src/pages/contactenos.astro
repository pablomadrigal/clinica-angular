---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AppointmentWizard from '../components/booking/AppointmentWizard.astro';
import BackHome from '../components/BackHome.astro';
import Contact from '../components/icons/Contact.astro';
import Social from '../components/icons/Social.astro';
import { CHAT_URL } from '../lib/whatsapp';
import insta from '../assets/Insta-GC-2-1.jpg';
import horario from '../assets/Group-245464942.png';
import direccion from '../assets/Group-245464943.png';
import { site } from '../data/site';

const socials = [
  { name: 'facebook' as const, href: site.social.facebook, label: 'facebook.com/AngularClinica' },
  { name: 'instagram' as const, href: site.social.instagram, label: 'instagram.com/clinica_angular' },
  { name: 'tiktok' as const, href: site.social.tiktok, label: '@ClinicaDelPieAngular' },
];
const pills = [
  { name: 'phone' as const, href: site.phoneHref, label: site.phoneIntl, target: undefined },
  { name: 'mail' as const, href: `mailto:${site.email}`, label: site.email, target: undefined },
  { name: 'whatsapp' as const, href: CHAT_URL, label: site.whatsappIntl, target: '_blank' },
];
---
<Base title="Contáctenos - Clínica Angular">
  <section class="container-site pt-14 pb-10 text-center">
    <h2 class="text-[30px] font-semibold text-primary md:text-[45px]">CONTÁCTENOS</h2>
  </section>
  <section class="bg-bg-alt py-10 md:py-14">
    <div class="container-site grid items-start gap-8 lg:grid-cols-2">
      <div>
        <h2 class="mb-4 text-[26px] md:text-[32px]">Agendá tu cita en pocos pasos</h2>
        <AppointmentWizard />
      </div>
      <div class="rounded-md bg-white p-6">
        <iframe src={site.mapEmbedUrl} title="Ubicación de Clínica Angular" class="h-[290px] w-full rounded border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <h3 class="mt-5 flex items-start gap-3 text-[15px] font-medium text-primary">
          <Contact name="pin" class="mt-0.5 h-5 w-5 shrink-0" />
          {site.addresses.contacto}
        </h3>
        <h3 class="mt-2 flex items-center gap-3 text-[15px] font-medium text-primary">
          <Contact name="phone" class="h-5 w-5 shrink-0" />
          <a href={site.phoneHref}>{site.phoneIntl}</a>
        </h3>
      </div>
    </div>
  </section>
  <section class="container-site py-10 md:py-14">
    <div class="grid items-center gap-10 lg:grid-cols-3">
      <Image src={insta} alt="Clínica Angular en Instagram" width={360} class="mx-auto w-full max-w-[280px] rounded-2xl shadow-md" />
      <div class="space-y-8 text-center">
        <div>
          <Image src={horario} alt="Horario" width={220} class="mx-auto h-auto w-[220px]" />
          {site.hoursLong.map((h) => <p class="mt-3 text-[15px] text-text">{h}</p>)}
        </div>
        <div>
          <Image src={direccion} alt="Dirección" width={220} class="mx-auto h-auto w-[220px]" />
          <p class="mt-3 text-[15px] text-text">{site.addresses.contactoLargo}</p>
        </div>
      </div>
      <div class="flex flex-col items-center gap-4">
        {pills.map((p) => (
          <a href={p.href} target={p.target} rel={p.target === '_blank' ? 'noopener' : undefined} class="flex w-full max-w-[240px] items-center justify-center gap-3 rounded-full bg-primary px-6 py-3 text-[14px] font-medium text-white transition-colors hover:bg-primary-dark">
            <Contact name={p.name} class="h-4 w-4 shrink-0" />
            {p.label}
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="container-site py-10 text-center md:py-14">
    <h2 class="text-[25px] font-semibold text-primary md:text-[35px]">¡Síganos también en Redes Sociales!</h2>
    <ul class="mt-8 grid gap-8 sm:grid-cols-3">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" class="flex flex-col items-center gap-3">
            <span class="grid h-14 w-14 place-items-center rounded-xl bg-primary text-white"><Social name={s.name} class="h-6 w-6" /></span>
            <span class="text-[15px] font-semibold text-accent-text">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <BackHome />
</Base>
