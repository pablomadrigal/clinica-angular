---
import { site } from '../../data/site';
---
{/* Franja de marca con las cifras que la clínica declara en su documento institucional. */}
<section class="section-y bg-primary text-white">
  <div class="container-site">
    <h2 class="title-section font-semibold text-white">Por qué Clínica Angular</h2>
    <dl class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {site.stats.map((s) => (
        <div data-animate>
          <dt class="font-display text-[2.5rem] font-semibold leading-none text-accent-light">{s.value}</dt>
          <dd class="mt-3 text-[17px] leading-relaxed text-white/90">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
