---
import { Image } from 'astro:assets';
import banner2 from '../../assets/Banner-2-e1770682456920.png';
import banner2Mobile from '../../assets/Diseno-sin-titulo.jpg';
import podologia from '../../assets/podologia-banner.jpg';
import medicina from '../../assets/medicina-general-1.jpg';
import banner6 from '../../assets/Banner-6-e1764877042937.png';
import psicologia from '../../assets/Psicologia.jpg';
import fisioterapia from '../../assets/Fisioterapia.jpg';
import estetica from '../../assets/Estetica.jpg';
import { nl2br } from '../../lib/text';

// Color del texto por slide, elegido según el fondo real de cada imagen (revisado contra
// reference/screenshots/index-desktop.png e index-mobile.png):
// - 'dark'    (#2a2525): slide 1, fondo claro con las franjas diagonales de marca.
// - 'primary' (morado):  fondos claros/blancos con franjas diagonales (podología, psicología, estética).
// - 'white':             fondos oscuros o fotos sin zona clara (medicina general, K-Laser, fisioterapia).
type TextColor = 'dark' | 'primary' | 'white';

interface Slide {
  bg: ImageMetadata;
  bgMobile?: ImageMetadata;
  title: string;
  text?: string;
  cta: string;
  href: string;
  color: TextColor;
  // Fisioterapia.jpg es una foto de cancha completa sin zona clara para el texto: se añade un
  // velo oscuro a la izquierda para que el título en blanco sea legible (no aplica a las demás,
  // que ya traen fondo claro u oscuro sólido de fábrica).
  overlay?: boolean;
}

const slides: Slide[] = [
  {
    bg: banner2,
    bgMobile: banner2Mobile,
    title: 'BRINDAMOS MÁS QUE\nUN SERVICIO DE SALUD',
    text: 'Ofrecemos desde un proceso de acompañamiento, educación\ny curación, hasta todo el tratamiento posterior\nque requiera el paciente.',
    cta: 'Ver Especialidades',
    href: '/especialidades/',
    color: 'dark',
  },
  { bg: podologia, title: 'PODOLOGÍA', cta: 'Más información', href: '/especialidades/podologia/', color: 'primary' },
  {
    bg: medicina,
    title: 'MEDICINA GENERAL Y\nTRASTORNOS DEL SUEÑO',
    cta: 'Más información',
    href: '/medicina-general/',
    color: 'white',
  },
  {
    bg: banner6,
    title: 'K-Laser CUBE 4',
    text: 'Somos la única clínica de podología en utilizar un láser de alta\npotencia en Costa Rica, capaz de penetrar en la profundidad de los\ntejidos, regenerar células y acelerar el tiempo de recuperación.',
    cta: 'Más información',
    href: '/k-laser/',
    color: 'white',
  },
  { bg: psicologia, title: 'PSICOLOGÍA', cta: 'Más información', href: '/especialidades/psicologia/', color: 'primary' },
  { bg: fisioterapia, title: 'FISIOTERAPIA', cta: 'Más información', href: '/fisioterapia/', color: 'white', overlay: true },
  { bg: estetica, title: 'SERVICIO DE ESTÉTICA', cta: 'Más información', href: '/servicio-de-estetica/', color: 'primary' },
];

const textClass: Record<TextColor, string> = {
  dark: 'text-text',
  primary: 'text-primary',
  white: 'text-white',
};

// En móvil la foto se recorta a un encuadre casi cuadrado y el sujeto queda justo debajo del
// texto (en el banner 1, sobre la cara del doctor), así que el título se volvía ilegible. Se
// añade un velo degradado solo en móvil, del color contrario al del texto de cada slide; en
// móvil sustituye al velo `overlay` de escritorio, que es más suave.
const scrimClass: Record<TextColor, string> = {
  dark: 'bg-gradient-to-r from-white/90 via-white/70 to-white/20',
  primary: 'bg-gradient-to-r from-white/90 via-white/70 to-white/20',
  white: 'bg-gradient-to-r from-black/70 via-black/45 to-black/10',
};
---
<section class="hero-swiper swiper relative h-[460px] md:h-[520px]" aria-label="Destacados">
  <div class="swiper-wrapper">
    {slides.map((s, i) => (
      <div class="swiper-slide relative overflow-hidden">
        <Image
          src={s.bg}
          alt=""
          width={1920}
          height={640}
          data-parallax
          class:list={['absolute inset-0 h-full w-full object-cover', s.bgMobile && 'hidden md:block']}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
        {s.bgMobile && (
          <Image src={s.bgMobile} alt="" width={800} height={800} class="absolute inset-0 h-full w-full object-cover md:hidden" loading="eager" />
        )}
        {s.overlay && <div class="absolute inset-0 hidden bg-gradient-to-r from-black/45 via-black/15 to-transparent md:block" />}
        <div class:list={['absolute inset-0 md:hidden', scrimClass[s.color]]} aria-hidden="true"></div>
        <div class="container-site relative flex h-full items-center">
          <div class="max-w-[560px]">
            <h2 class:list={['text-[26px] font-semibold leading-tight sm:text-[28px] md:text-[45px]', textClass[s.color]]} set:html={nl2br(s.title)} />
            {/* Los saltos de línea del texto están pensados para el ancho de escritorio; en
                móvil dejarían renglones sueltos a media frase, así que ahí el párrafo fluye
                (el <br /> solo aparece desde `md`, con un espacio real que lo sustituye). */}
            {s.text && (
              <p class:list={['mt-4 text-[14px] leading-relaxed sm:text-[15px] md:text-[16px]', textClass[s.color]]}>
                {s.text.split('\n').map((line, idx) => (
                  <Fragment>
                    {idx > 0 && <br class="hidden md:inline" />}
                    {idx > 0 && ' '}
                    {line}
                  </Fragment>
                ))}
              </p>
            )}
            <a
              href={s.href}
              class:list={[
                'mt-6 inline-block rounded-[22px] bg-accent px-7 py-3.5 text-[13px] font-semibold text-text shadow-sm hover:bg-accent-light',
                i === 0 && 'uppercase',
              ]}
            >{s.cta}</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="swiper-pagination !bottom-4"></div>
  <button type="button" class="hero-prev absolute left-3 top-1/2 z-10 hidden -translate-y-1/2 text-accent hover:text-accent-text md:block" aria-label="Anterior">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-8 w-8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
  </button>
  <button type="button" class="hero-next absolute right-3 top-1/2 z-10 hidden -translate-y-1/2 text-accent hover:text-accent-text md:block" aria-label="Siguiente">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-8 w-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
  </button>
</section>

<style is:global>
  .hero-swiper .swiper-pagination-bullet { background: var(--color-accent-light); opacity: 1; width: 10px; height: 10px; }
  .hero-swiper .swiper-pagination-bullet-active { background: #2a2525; }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';
  import 'swiper/css/navigation';

  new Swiper('.hero-swiper', {
    modules: [Autoplay, Navigation, Pagination],
    loop: true,
    speed: 500,
    autoplay: { delay: 5000, disableOnInteraction: false },
    pagination: { el: '.hero-swiper .swiper-pagination', clickable: true },
    navigation: { prevEl: '.hero-prev', nextEl: '.hero-next' },
  });
</script>
