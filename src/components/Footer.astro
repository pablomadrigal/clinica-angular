---
import { Image } from 'astro:assets';
import logo from '../assets/Logo-Angular-1.png';
import payments from '../assets/Contactenos-footer.png';
import cards from '../assets/Group-245464935-1.png';
import { site } from '../data/site';
import Social, { socialLabels } from './icons/Social.astro';
import Contact from './icons/Contact.astro';
---
<footer class="bg-primary text-white">
  <div class="container-site grid gap-10 py-12 text-center md:grid-cols-3 md:text-left">
    <div class="flex justify-center md:justify-start">
      <Image src={logo} alt="Clínica Angular" width={220} class="w-[220px]" />
    </div>
    <div class="flex flex-col items-center md:items-start">
      <h2 class="text-[18px] font-medium text-accent-light">Verified by Visa and Master Card</h2>
      <Image src={payments} alt="Verified by Visa y MasterCard SecureCode" width={180} class="my-4 w-[180px]" />
      <h2 class="text-[14px] font-normal text-white">La forma segura de pagar en línea.</h2>
      <Image src={cards} alt="Tarjetas aceptadas" width={200} class="mt-3 w-[200px]" />
    </div>
    <div class="flex flex-col items-center md:items-start">
      <h2 class="text-[22px] font-semibold text-accent-light">Contáctenos</h2>
      <ul class="mt-4 space-y-3 text-[14px]">
        <li class="flex items-start gap-3 text-left">
          <Contact name="pin" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-accent-light" />
          <h3 class="font-normal text-white">
            {site.addresses.footer.map((l) => <span class="block">{l}</span>)}
          </h3>
        </li>
        <li class="flex items-start gap-3 text-left">
          <Contact name="phone" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-accent-light" />
          <h3 class="font-normal text-white"><a href={site.phoneHref}>{site.phoneIntl}</a></h3>
        </li>
        <li class="flex items-start gap-3 text-left">
          <Contact name="mail" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-accent-light" />
          <h3 class="font-normal text-white"><a href={`mailto:${site.email}`}>{site.email}</a></h3>
        </li>
      </ul>
      <ul class="mt-5 flex gap-2">
        {(['facebook', 'instagram', 'tiktok'] as const).map((n) => (
          <li>
            <a href={site.social[n]} target="_blank" rel="noopener" aria-label={socialLabels[n]} class="grid h-8 w-8 place-items-center rounded-md bg-white/20 text-white hover:bg-white hover:text-primary">
              <Social name={n} class="h-4 w-4" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-site py-4 text-center text-[12px] text-white/80 md:text-left">{site.copyright}</p>
  </div>
</footer>
