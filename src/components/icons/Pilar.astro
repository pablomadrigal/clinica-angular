---
// Iconos de "Los Pilares de Nuestra Empresa" (nuestra-empresa.astro).
//
// 6 de los 7 iconos (innovacion, adaptabilidad, efectividad, solidaridad, respeto,
// escucha) son los SVG originales del sitio, extraidos verbatim de los widgets
// `icon-box` de Elementor en reference/source/nuestra-empresa.html (ids de widget
// c85e06e, c2d3b76, ebc3899, 9de9346, 76da672, 6617f8c respectivamente) con un script
// Python (scratchpad/gen_icons2.py, no versionado): cada SVG original embebe, ademas
// del icono, un primer <path> gigante que dibuja el titulo ("Innovacion", etc.) como
// contorno vectorial en la franja inferior del viewBox -- ese path se descarta (el
// titulo real ya se pinta como texto HTML accesible en nuestra-empresa.astro) y el
// resto de paths/circles se recorta a un viewBox propio por icono. Los fills
// #3D387F (y variantes de anti-aliasing/trazado muy cercanas) se mapean a
// var(--color-primary); los naranjas (#EC873B/#ED853A/#F58336/#F48438, uno por
// icono) se mantienen tal cual del original en vez de forzar var(--color-accent-text),
// que es notablemente mas apagado (#B45309) que el naranja vivo de la referencia.
//
// El septimo icono, "sostenibilidad" (widget b04d9c5), no es vector puro: el globo
// esta compuesto con un <rect fill="url(#pattern0)"> que referencia una imagen
// PNG en base64 embebida en <defs>. No se intento incrustar ese raster; en su lugar
// es un redibujo fiel a mano (globo + dos hojas cruzadas, ver captura de referencia)
// usando los mismos tokens de color.
interface Props {
  name: 'sostenibilidad' | 'innovacion' | 'adaptabilidad' | 'efectividad' | 'solidaridad' | 'respeto' | 'escucha';
  class?: string;
}
const { name, class: cls = 'h-16 w-16' } = Astro.props;
---
{name === 'sostenibilidad' && (
  <svg class={cls} viewBox="0 0 64 64" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="30" cy="42" r="14" stroke="var(--color-primary)" stroke-width="2.1"/>
    <path d="M19.4 26.8A18.5 18.5 0 1 0 28.4 60.4" stroke="var(--color-primary)" stroke-width="2.1"/>
    <path d="M18 36c3.8 2.8 9.5 3.4 14.5 1.2M16.3 43.3c4.8 2 10.4 1.7 15.3-1M25 30c1.4 4 .8 9.4-1.4 13.6M30.5 30.8c2.1 4.2 2 10.2-.2 15" stroke="var(--color-primary)" stroke-width="1.3"/>
    <path d="M30,33 Q25.9,22.7 15,21 Q19.1,31.3 30,33 Z" stroke="var(--color-primary)" stroke-width="1.9"/>
    <path d="M30,33 L16.5,22" stroke="var(--color-primary)" stroke-width="1.2"/>
    <path d="M31,32 Q41.1,29.6 45,20 Q34.9,22.4 31,32 Z" stroke="#EC873B" stroke-width="1.9"/>
    <path d="M31,32 L43.5,21" stroke="#EC873B" stroke-width="1.2"/>
  </svg>
)}
