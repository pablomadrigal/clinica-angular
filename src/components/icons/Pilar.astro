---
// Iconos de "Los Pilares de Nuestra Empresa" (nuestra-empresa.astro). El dump del sitio
// original pierde las imágenes de los widgets `icon-box` de Elementor; estos son un
// redibujo simplificado a dos tonos (primary/accent-dark) que conserva el tema de cada
// ícono visto en la captura de referencia, no una copia pixel a pixel del original.
interface Props {
  name: 'sostenibilidad' | 'innovacion' | 'adaptabilidad' | 'efectividad' | 'solidaridad' | 'respeto' | 'escucha';
  class?: string;
}
const { name, class: cls = 'h-16 w-16' } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'sostenibilidad' && (
    <>
      <circle cx="28" cy="34" r="16" class="text-primary" stroke="currentColor" />
      <path d="M17 26c5 6 13 6 22 2M15 36c7 3 16 2 24-3" class="text-primary" stroke="currentColor" />
      <path d="M36 16c6 0 10 4 10 4s-2 6-8 6-8-4-8-4 0-6 6-6Z" class="text-accent-dark" stroke="currentColor" fill="currentColor" fill-opacity="0.15" />
    </>
  )}
  {name === 'innovacion' && (
    <>
      <path d="M32 12a12 12 0 0 0-7 21.8V38h14v-4.2A12 12 0 0 0 32 12Z" class="text-primary" stroke="currentColor" />
      <path d="M27 44h10M28 49h8" class="text-primary" stroke="currentColor" />
      <circle cx="32" cy="24" r="3.2" class="text-accent-dark" stroke="currentColor" />
      <path d="M32 8v3M18 24h-3M49 24h-3M21.5 13.5l-2-2M42.5 13.5l2-2" class="text-accent-dark" stroke="currentColor" />
    </>
  )}
  {name === 'adaptabilidad' && (
    <>
      <path d="M46 24a14 14 0 0 0-24-8" class="text-accent-dark" stroke="currentColor" />
      <path d="M18 20v6h6" class="text-accent-dark" stroke="currentColor" />
      <path d="M18 40a14 14 0 0 0 24 8" class="text-accent-dark" stroke="currentColor" />
      <path d="M46 44v-6h-6" class="text-accent-dark" stroke="currentColor" />
      <rect x="27" y="27" width="10" height="10" rx="2" class="text-primary" stroke="currentColor" />
    </>
  )}
  {name === 'efectividad' && (
    <>
      <circle cx="32" cy="32" r="18" class="text-primary" stroke="currentColor" />
      <path d="M26 30v10h10.5c1.9 0 3.3-1.8 2.8-3.6l-1.6-6a2.9 2.9 0 0 0-2.8-2.1H30l1-5.2c.3-1.5-1-2.9-2.5-2.6-.7.1-1.3.6-1.6 1.3L24 27" class="text-primary" stroke="currentColor" stroke-linejoin="round" />
      <path d="M26 30h-3v10h3" class="text-primary" stroke="currentColor" />
      <circle cx="32" cy="32" r="1.4" class="text-accent-dark" stroke="currentColor" fill="currentColor" />
    </>
  )}
  {name === 'solidaridad' && (
    <>
      <path d="M32 28c-2.4-4-9-3.4-9 2 0 4.5 6 7.6 9 9.6 3-2 9-5.1 9-9.6 0-5.4-6.6-6-9-2Z" class="text-accent-dark" stroke="currentColor" />
      <path d="M13 43c2 6 9 10 19 10s17-4 19-10" class="text-primary" stroke="currentColor" />
      <path d="M17 41c-2.2 2-3 4.3-1.8 6.6M47 41c2.2 2 3 4.3 1.8 6.6" class="text-primary" stroke="currentColor" />
    </>
  )}
  {name === 'respeto' && (
    <>
      <path d="M32 46C20 38 13 31 13 23c0-6 4.5-10 10-10 4 0 7 2 9 5 2-3 5-5 9-5 5.5 0 10 4 10 10 0 8-7 15-19 23Z" class="text-accent-dark" stroke="currentColor" />
      <path d="M18 34h6l4-4 4 5 4-5 4 4h6" class="text-primary" stroke="currentColor" stroke-width="2.6" />
      <circle cx="32" cy="35" r="1.6" class="text-primary" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'escucha' && (
    <>
      <path d="M28 14c-8 0-13 7-13 15 0 6 3 8 3 12 0 2.5 2 4 4.2 4 2.4 0 4-2 4-4.3V33c0-1.6 1.3-2.5 2.8-2.1 2.5.7 5-1.2 5-3.8 0-1.7-1.1-3.1-2.7-3.6 1.8-.6 3-2.3 2.7-4.3-.4-2.7-3-4.3-6-4.3Z" class="text-primary" stroke="currentColor" />
      <path d="M40 24c2 1.5 2 6.5 0 8M45 20c4 3 4 12.5 0 15.5M50 16c6 4.5 6 19 0 23.5" class="text-accent-dark" stroke="currentColor" />
    </>
  )}
</svg>
