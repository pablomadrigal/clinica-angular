---
// Formulario "Generar una cita": abre WhatsApp con el mensaje prellenado. Sin backend.
// Usa un selector de clase (no id) porque una misma página puede incluir más de un ContactForm
// (p. ej. Inicio + Beneficios reutilizan este componente); cada instancia se maneja por separado
// buscando sus propios campos con `form.querySelector`.
---
<form data-appointment-form class="space-y-3" novalidate>
  <label class="block"><span class="sr-only">Name</span><input name="name" type="text" required placeholder="Tu nombre*" class="w-full rounded-xl border-0 bg-white px-4 py-2.5 text-[14px] outline-none focus:ring-2 focus:ring-primary/40" /></label>
  <label class="block"><span class="sr-only">Email</span><input name="email" type="email" required placeholder="Email*" class="w-full rounded-xl border-0 bg-white px-4 py-2.5 text-[14px] outline-none focus:ring-2 focus:ring-primary/40" /></label>
  <label class="block"><span class="sr-only">Phone number</span><input name="phone" type="tel" required placeholder="Celular*" class="w-full rounded-xl border-0 bg-white px-4 py-2.5 text-[14px] outline-none focus:ring-2 focus:ring-primary/40" /></label>
  <label class="block"><span class="sr-only">Message</span><textarea name="message" rows="4" placeholder="Tu mensaje" class="w-full rounded-xl border-0 bg-white px-4 py-2.5 text-[14px] outline-none focus:ring-2 focus:ring-primary/40"></textarea></label>
  <p data-form-error role="status" aria-live="polite" class="hidden text-[13px] text-red-600">Complete nombre, correo y teléfono.</p>
  <button type="submit" class="w-full rounded-lg bg-primary py-3 text-[13px] font-semibold uppercase tracking-wide text-white hover:bg-purple-dark">Generar una cita</button>
  <a data-form-fallback href="#" target="_blank" rel="noopener" class="hidden text-center text-[13px] text-primary underline">Si no se abrió WhatsApp, toque aquí.</a>
</form>
<script>
  import { buildAppointmentUrl } from '../lib/whatsapp';
  document.querySelectorAll<HTMLFormElement>('form[data-appointment-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = (id: string) => (form.querySelector<HTMLInputElement>(`[name="${id}"]`)?.value ?? '');
      const fields = { name: f('name'), email: f('email'), phone: f('phone'), message: f('message') };
      const err = form.querySelector<HTMLElement>('[data-form-error]')!;
      if (!form.checkValidity()) {
        err.classList.remove('hidden');
        form.reportValidity();
        return;
      }
      err.classList.add('hidden');
      const url = buildAppointmentUrl(fields);
      const fb = form.querySelector<HTMLAnchorElement>('[data-form-fallback]')!;
      fb.href = url;
      fb.classList.remove('hidden');
      window.open(url, '_blank', 'noopener');
    });
  });
</script>
