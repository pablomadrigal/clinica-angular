---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { nl2br } from '../lib/text';

interface Props { entry: CollectionEntry<'specialists'> }
const { entry } = Astro.props;
const d = entry.data;
---
<article class="grid gap-8 border-b border-border py-12 last:border-b-0 md:grid-cols-[320px_1fr]" data-animate>
  <div class="flex flex-col items-center text-center">
    <p class="mb-3 text-[15px] font-bold uppercase tracking-[0.1em] text-accent-text" set:html={nl2br(d.role)} />
    <Image src={d.photo} alt={d.name} width={350} height={350} class="h-[175px] w-[175px] rounded-full object-cover object-top shadow-lift" />
    <h2 class="mt-4 title-card font-semibold text-primary" set:html={nl2br(d.name)} />
    {d.code && <p class="mt-1 text-[15px] text-muted">{d.code}</p>}
  </div>
  <div>
    <h3 class="text-center title-card font-semibold text-accent-text">{d.profileTitle}</h3>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-[17px] leading-relaxed text-text marker:text-primary">
      {d.profile.map((line) => <li>{line}</li>)}
    </ul>
  </div>
</article>
