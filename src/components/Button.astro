---
interface Props {
  href: string;
  // El dorado `accent` solo vive como FONDO con texto tinta encima; como texto no pasa AA
  // (ver src/lib/palette.test.ts). Por eso no existe una variante de texto dorado.
  variant?: 'accent' | 'primary' | 'white' | 'chat' | 'whatsapp' | 'appointment' | 'outline';
  // 'pill' (por defecto) = radio completo + mayúsculas. 'rounded' = 10px + texto tal cual.
  shape?: 'pill' | 'rounded';
  caps?: boolean;
  class?: string;
  target?: string;
}
const { href, variant = 'accent', shape = 'pill', caps = true, class: cls = '', target } = Astro.props;
const styles = {
  accent: 'bg-accent text-text shadow-soft hover:bg-accent-text hover:text-white',
  primary: 'bg-primary text-white shadow-soft hover:bg-primary-dark',
  white: 'bg-white text-primary shadow-soft hover:bg-bg-alt',
  chat: 'bg-chat text-text hover:brightness-95',
  whatsapp: 'bg-whatsapp text-text hover:brightness-95',
  appointment: 'bg-accent text-text shadow-soft hover:bg-accent-text hover:text-white',
  outline: 'border-white text-white hover:bg-white/15',
};
---
<a
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener' : undefined}
  class:list={[
    /* 56px de alto: objetivo táctil cómodo, que es lo que pide el público de la clínica. */
    'inline-flex min-h-[56px] items-center justify-center gap-2 border-2 border-transparent px-7 py-3 text-[17px] font-semibold leading-tight transition-[background-color,color,transform] motion-safe:hover:-translate-y-0.5',
    shape === 'pill' ? 'rounded-full' : 'rounded-field',
    caps && 'text-[15px] uppercase tracking-wide',
    styles[variant],
    cls,
  ]}
><slot name="icon" /><slot /></a>
