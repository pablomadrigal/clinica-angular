---
// Panel de "padecimiento": columna centrada con encabezado, imagen (opcional), subtítulo y
// párrafos. Siempre se pinta sobre fondo blanco: en los datos reales las secciones `condition`
// y `treatments` se alternan estrictamente C,T,T,C, lo que ya reproduce el tablero de ajedrez
// blanco/morado del sitio original (ver [...slug].astro) sin necesitar un índice de posición.
// Comparte el "esqueleto" de columna centrada con TopicsSection (modo "compact") vía
// CenteredBlock; aquí solo se define el contenido intermedio (subtítulo + párrafos).
import CenteredBlock from './CenteredBlock.astro';

interface Props {
  heading: string;
  image?: ImageMetadata;
  subheading?: string;
  body: string[];
  // Definido en el esquema de contenido (`content.config.ts`) para las secciones `condition`,
  // pero este layout es de una sola columna centrada: no hay una imagen a un lado que reordenar,
  // así que se acepta el prop (para no perder el dato silenciosamente) pero no tiene efecto
  // visual aquí. Compárese con TopicsSection en modo "split", que sí usa `imageSide` en un
  // layout de dos columnas real.
  imageSide: 'left' | 'right';
  showChat: boolean;
}
const { heading, image, subheading, body, showChat } = Astro.props;
---

<CenteredBlock heading={heading} image={image} imageAlt={heading || subheading || ''} showChat={showChat}>
  {subheading && <p class="mb-4 text-[17px] font-medium text-accent-text md:text-[19px]">{subheading}</p>}
  <div class="max-w-[540px] space-y-4">
    {body.map((p) => <p class="text-[15px] leading-relaxed text-primary/80">{p}</p>)}
  </div>
</CenteredBlock>
