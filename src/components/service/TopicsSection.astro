---
// Sección "tema": el sitio original usa tres variantes según los datos, determinadas aquí sin
// bandera explícita en el contenido:
// - "split": tiene imagen + ítems con checklist (body con líneas "✓ …", ej. psicología). Ocupa
//   la fila completa: mitad imagen (blanco) / mitad checklist (morado), lado según `imageSide`.
// - "compact": tiene imagen pero los ítems son solo un título narrativo, sin checklist (ej.
//   medicina general). Es una sola celda (como ConditionSection) coloreada por `bg`, que
//   [...slug].astro calcula por posición en el tablero de ajedrez.
// - "list": no tiene imagen propia (ej. fisioterapia, estética). Columna única a todo el ancho
//   con los ítems apilados (título opcional + párrafos) y los botones al final.
import { Image } from 'astro:assets';
import AppointmentButton from '../AppointmentButton.astro';
import ChatButton from '../ChatButton.astro';

interface Props {
  heading?: string;
  image?: ImageMetadata;
  imageSide: 'left' | 'right';
  items: { title?: string; body: string[] }[];
  showAppointment: boolean;
  showChat: boolean;
  bg?: 'white' | 'purple';
}
const { heading, image, imageSide, items, showAppointment, showChat, bg = 'white' } = Astro.props;

const hasChecklist = items.some((it) => it.body.length > 0);
const mode = image ? (hasChecklist ? 'split' : 'compact') : 'list';
---

{
  mode === 'split' && (
    <div class="grid md:grid-cols-2">
      <div class:list={['flex flex-col items-center justify-center gap-4 bg-white px-6 py-14 text-center sm:px-10 md:px-14', imageSide === 'right' && 'md:order-2']}>
        {heading && <h2 class="text-[20px] font-bold text-accent md:text-[24px]" set:html={heading.replace(/\n/g, '<br />')} />}
        <Image src={image!} alt={heading ?? ''} width={640} height={480} class="w-full max-w-[420px] rounded-2xl object-cover" />
      </div>
      <div class="flex flex-col justify-center gap-6 bg-primary px-6 py-14 text-white sm:px-10 md:px-14">
        {items.map((it) => (
          <div>
            {it.title && <h3 class="mb-2 text-[18px] font-bold text-accent">{it.title}</h3>}
            <div class="space-y-4">
              {it.body.map((p) => <p class="text-[15px] leading-relaxed text-white/90">{p}</p>)}
            </div>
          </div>
        ))}
        {(showChat || showAppointment) && (
          <div class="mt-2 flex flex-wrap justify-center gap-3">
            {showChat && <ChatButton />}
            {showAppointment && <AppointmentButton />}
          </div>
        )}
      </div>
    </div>
  )
}

{
  mode === 'compact' && (
    <div class:list={['flex flex-col items-center px-6 py-14 text-center sm:px-10 md:px-14', bg === 'purple' ? 'bg-primary text-white' : 'bg-white']}>
      {heading && <h3 class="mb-6 text-[20px] font-bold text-accent md:text-[24px]">{heading}</h3>}
      <Image src={image!} alt={heading ?? ''} width={640} height={480} class="mb-6 w-full max-w-[300px] rounded-2xl object-cover" />
      <div class="max-w-[480px] space-y-2">
        {items.map((it) => it.title && <p class:list={['text-[15px] font-semibold leading-relaxed', bg === 'purple' ? 'text-accent' : 'text-primary']} set:html={it.title.replace(/\n/g, '<br />')} />)}
      </div>
      {(showChat || showAppointment) && (
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {showChat && <ChatButton />}
          {showAppointment && <AppointmentButton />}
        </div>
      )}
    </div>
  )
}

{
  mode === 'list' && (
    <div class="mx-auto max-w-[820px] px-6 py-10 text-center">
      {heading && <h2 class="mb-8 text-[20px] font-bold text-accent md:text-[24px]" set:html={heading.replace(/\n/g, '<br />')} />}
      <div class="space-y-8">
        {items.map((it) => (
          <div>
            {it.title && <h3 class="mb-2 text-[19px] font-bold text-accent md:text-[22px]" set:html={it.title.replace(/\n/g, '<br />')} />}
            {it.body.map((p) => <p class="text-left text-[15px] leading-relaxed text-primary/80">{p}</p>)}
          </div>
        ))}
      </div>
      {(showChat || showAppointment) && (
        <div class="mt-8 flex flex-col items-center gap-6">
          {showChat && <ChatButton />}
          {showAppointment && <AppointmentButton />}
        </div>
      )}
    </div>
  )
}
