---
// Sección "tema": el sitio original usa tres variantes según los datos, determinadas aquí sin
// bandera explícita en el contenido:
// - "split": tiene imagen + ítems con checklist (body con líneas "✓ …", ej. psicología). Ocupa
//   la fila completa: mitad imagen (blanco) / mitad checklist (morado), lado según `imageSide`.
//   Entre cada fila y la anterior (todas menos la primera de la página) el original pinta un
//   pequeño divisor naranja en la esquina superior izquierda de la fila; se controla con `first`
//   (lo calcula [...slug].astro a partir del índice de la sección dentro de `d.sections`).
// - "compact": tiene imagen pero los ítems son solo un título narrativo, sin checklist (ej.
//   medicina general). Es una sola celda (como ConditionSection) coloreada por `bg`, que
//   [...slug].astro calcula por posición en el tablero de ajedrez. Comparte el "esqueleto" de
//   columna centrada con ConditionSection vía CenteredBlock.
// - "list": no tiene imagen propia (ej. fisioterapia, estética). Columna única a todo el ancho
//   con los ítems apilados (título opcional + párrafos) y los botones al final.
import { Image } from 'astro:assets';
import { nl2br } from '../../lib/text';
import ActionButtons from './ActionButtons.astro';
import CenteredBlock from './CenteredBlock.astro';

interface Props {
  heading?: string;
  image?: ImageMetadata;
  imageSide: 'left' | 'right';
  items: { title?: string; body: string[] }[];
  showAppointment: boolean;
  showChat: boolean;
  bg?: 'white' | 'purple';
  // Solo se usa en modo "split": si es la primera sección "topics" de la página, no se dibuja el
  // divisor superior (ver nota arriba). Por defecto true para que un caller que no lo pase nunca
  // muestre un divisor "huérfano".
  first?: boolean;
}
const { heading, image, imageSide, items, showAppointment, showChat, bg = 'white', first = true } = Astro.props;

const hasChecklist = items.some((it) => it.body.length > 0);
const mode = image ? (hasChecklist ? 'split' : 'compact') : 'list';
---

{
  mode === 'split' && (
    <div class="relative grid md:grid-cols-2">
      {!first && <span class="absolute left-6 top-0 h-0.5 w-24 bg-accent sm:left-10 md:left-14" aria-hidden="true" />}
      <div class:list={['flex flex-col items-center justify-center gap-4 bg-white px-5 py-10 text-center sm:px-10 md:px-14 md:py-14', imageSide === 'right' && 'md:order-2']}>
        {heading && <h2 class="text-[20px] font-bold text-accent md:text-[24px]" set:html={nl2br(heading)} />}
        <Image src={image!} alt={heading ?? ''} width={640} height={480} class="w-full max-w-[420px] rounded-2xl object-cover" />
      </div>
      <div class="flex flex-col justify-center gap-6 bg-primary px-5 py-10 text-white sm:px-10 md:px-14 md:py-14">
        {items.map((it) => (
          <div>
            {it.title && <h3 class="mb-2 text-[18px] font-bold text-accent-light">{it.title}</h3>}
            <div class="space-y-4">
              {it.body.map((p) => <p class="text-[15px] leading-relaxed text-white/90">{p}</p>)}
            </div>
          </div>
        ))}
        <ActionButtons showChat={showChat} showAppointment={showAppointment} class="mt-2" />
      </div>
    </div>
  )
}

{
  mode === 'compact' && (
    <CenteredBlock
      heading={heading}
      image={image}
      bg={bg}
      showChat={showChat}
      showAppointment={showAppointment}
      imageClass="mb-6 w-full max-w-[300px] rounded-2xl object-cover"
    >
      <div class="max-w-[480px] space-y-2">
        {items.map(
          (it) =>
            it.title && (
              <p class:list={['text-[15px] font-semibold leading-relaxed', bg === 'purple' ? 'text-accent-light' : 'text-primary']} set:html={nl2br(it.title)} />
            ),
        )}
      </div>
    </CenteredBlock>
  )
}

{
  mode === 'list' && (
    <div class="mx-auto max-w-[820px] px-5 py-10 text-center sm:px-6">
      {heading && <h2 class="mb-8 text-[20px] font-bold text-accent md:text-[24px]" set:html={nl2br(heading)} />}
      <div class="space-y-8">
        {items.map((it) => (
          <div>
            {it.title && <h3 class="mb-2 text-[19px] font-bold text-accent md:text-[22px]" set:html={nl2br(it.title)} />}
            {it.body.map((p) => <p class="text-left text-[15px] leading-relaxed text-primary/80">{p}</p>)}
          </div>
        ))}
      </div>
      <ActionButtons showChat={showChat} showAppointment={showAppointment} layout="col" class="mt-8" />
    </div>
  )
}
