---
// Síntomas del padecimiento. Como el resto de los componentes de esta carpeta, la decisión de
// ocultarse vive acá: sin material, no pinta ni el encabezado (regla de secciones vacías del spec).
interface Props { items: string[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="section-y bg-bg-alt">
    <div class="container-site" data-animate>
      <h2 class="title-section">Síntomas</h2>
      <ul class="prose-measure mt-6 space-y-3">
        {items.map((s) => (
          <li class="flex gap-3">
            <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{s}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
