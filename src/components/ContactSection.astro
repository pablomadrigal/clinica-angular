---
import ContactForm from './ContactForm.astro';
import ChatButton from './ChatButton.astro';
import Contact from './icons/Contact.astro';
import { site } from '../data/site';

interface Props { address: string; showMap?: boolean; showChat?: boolean; title?: string; subtitle?: string }
const { address, showMap = true, showChat = true, title = '¡Contáctenos!', subtitle = 'Obtenga su cita ya' } = Astro.props;
---
<section class="section-y bg-bg-alt">
  <div class="container-site grid items-start gap-10 lg:grid-cols-2">
    <div>
      <h2 class="title-section font-semibold">{title}</h2>
      <p class="mb-6 mt-3 text-[15px] font-bold uppercase tracking-[0.1em] text-accent-text">{subtitle}</p>
      <ContactForm />
    </div>
    <div class="rounded-card border border-border bg-white p-6 shadow-soft">
      {showMap && (
        <iframe src={site.mapEmbedUrl} title="Ubicación de Clínica Angular" class="h-[290px] w-full rounded-field border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      )}
      <p class="mt-5 flex items-start gap-3 text-[16px] font-medium text-text">
        <Contact name="pin" class="mt-1 h-5 w-5 shrink-0 text-accent-text" />
        {address}
      </p>
      <p class="mt-3 flex items-center gap-3 text-[16px] font-medium text-text">
        <Contact name="phone" class="h-5 w-5 shrink-0 text-accent-text" />
        <a href={site.phoneHref} class="text-primary underline-offset-2 hover:underline">{site.phoneIntl}</a>
      </p>
      {showChat && (
        <div class="mt-6 flex justify-center">
          <ChatButton />
        </div>
      )}
    </div>
  </div>
</section>
